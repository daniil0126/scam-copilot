{
    "manifest_version": 3,
    "name": "Scam Copilot",
    "version": "1.0.0",
    "description": "wille be filled later",
    "permissions": [
        "storage"
    ],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ],
    "background": {
        "service_worker": "service_worker.js"
    },
    "action": {
        "default_title": "Toggle Scam Copilot"
    }
}
