# Extension ID. It is fixed by the "key" in public/manifest.json, so this value works as is.
PROJECT_ID=hjkgljmknkdiikgaflofnlmhbjjjilob
# PayPal Developer -> Apps & Credentials -> Sandbox -> your app
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional LLM. Leave empty to run on rules only. See app/llm.py for how to register a provider.
# `openrouter` works with free models only: LLM_MODEL must end in ":free" and its price must be zero on OpenRouter,
# otherwise the provider refuses to start. Use a separate OpenRouter key with a credit limit for this project.
LLM_PROVIDER=
LLM_API_KEY=
# Several models can be listed, comma-separated: the next one is tried when a free model is rate-limited (429) or withdrawn.
# Free models change often; the current ones are on openrouter.ai/models?q=free.
# Put the fastest first: a model that just failed is skipped for a minute, but the first one sets the usual speed.
LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,google/gemma-4-31b-it:free,cohere/north-mini-code:free
# Seconds between background polls of PayPal for new and changed invoices. 0 turns polling off.
MONITOR_INTERVAL_SECONDS=60
# Receives forwarded PayPal invoice emails at POST /inbound/email (header X-Inbound-Secret). Empty keeps it off.
INBOUND_EMAIL_SECRET=
# Id of the PayPal webhook registered for this app (Developer Dashboard). Turns on POST /webhooks/paypal; empty keeps it off.
# Needs a public HTTPS address (a tunnel or a host). Polling stays on as the fallback.
PAYPAL_WEBHOOK_ID=
# Which scorer decides the level and the findings.
#   unset or v1: the legacy scorer in app/scoring.py. This is the default and what the demo shows.
#   v2:          the rule engine in app/rules/. Calibrated on tests/dataset/cases.json; see
#                docs/plans/engine-comparison.md for the numbers (precision/recall at HIGH and MEDIUM).
RULES_ENGINE=